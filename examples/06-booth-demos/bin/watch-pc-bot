#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="$DEMO_DIR/pc-worker/.deployed-urls.env"

if [[ -f "$ENV_FILE" ]]; then
  source "$ENV_FILE"
else
  echo "⚠️  No pc-worker/.deployed-urls.env found. Run ./examples/06-booth-demos/bin/deploy-pc-cf first."
  exit 1
fi

curl -s -X POST "${RIGFOUNDRY_URL}/reset" >/dev/null || true

clear
printf "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n"
printf "\033[1;36m📡 Cloudflare Workers Live A2A Stream — Demo 1 (Window 3)\033[0m\n"
printf "   • RigFoundry (Website + A2A Bot): \033[4;36m%s\033[0m\n" "${RIGFOUNDRY_URL}"
printf "   • MockEgg (Retail Catalog Only):  \033[4;36m%s\033[0m\n" "${MOCKEGG_URL}"
printf "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n"

CURSOR=0
while true; do
  RESP="$(curl -s "${RIGFOUNDRY_URL}/logs?since=${CURSOR}" || echo '{}')"
  NEXT="$(printf "%s" "$RESP" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    for e in d.get("entries", []):
        print(e.get("text", ""), file=sys.stderr)
    print(d.get("nextCursor", 0))
except Exception:
    print(0)
' 2>&1 >/tmp/cf_pc_cursor.$$)"
  if [[ -n "$NEXT" ]]; then
    printf "%b\n" "$NEXT"
    if echo "$NEXT" | grep -q "ASYNC BACKGROUND JOB COMPLETED"; then
      osascript -e 'display notification "Order order-rf-vip-999 ($999 White+Walnut) verified & reserved!" with title "✅ RigFoundry PC Build-a-Bot" sound name "Glass"' 2>/dev/null || true
    fi
  fi
  if [[ -f "/tmp/cf_pc_cursor.$$" ]]; then
    NEW_C="$(cat "/tmp/cf_pc_cursor.$$" | tr -d '[:space:]')"
    rm -f "/tmp/cf_pc_cursor.$$"
    if [[ "$NEW_C" =~ ^[0-9]+$ ]] && (( NEW_C > CURSOR )); then
      CURSOR="$NEW_C"
    fi
  fi
  sleep 0.5
done
