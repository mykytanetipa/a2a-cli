#!/usr/bin/env python3
"""Transparent Python PTY wrapper for interactive `claude` sessions.
- Preserves real terminal stdin/stdout/stderr (no bash heredoc).
- Listens on `/tmp/a2a-wake.sock` so `a2a-poll-task` can inject push notification
  messages directly into Claude's chat input box and submit them with Return (`\\r`).
- Passes `-p` / `--print` or non-TTY invocations directly to the real `claude` binary.
"""
import fcntl
import os
import pathlib
import pty
import select
import shutil
import signal
import socket
import sys
import termios
import threading
import time
import tty


def find_real_claude(self_dir: str) -> tuple[str, str]:
  raw_path = os.environ.get("PATH", "")
  cleaned_dirs = [
      p for p in raw_path.split(os.pathsep)
      if p and os.path.realpath(p) != self_dir
  ]
  cleaned_path = os.pathsep.join(cleaned_dirs)
  real_bin = shutil.which("claude", path=cleaned_path) or ""
  return real_bin, cleaned_path


def main():
  self_dir = os.path.realpath(str(pathlib.Path(__file__).resolve().parent))
  real_claude, cleaned_path = find_real_claude(self_dir)
  if not real_claude:
    sys.stderr.write("Error: real `claude` binary not found in PATH\n")
    sys.exit(1)

  args = sys.argv[1:]
  # Pass non-interactive (`-p` / `--print`), nested, or non-TTY runs directly to real `claude`
  if (
      "-p" in args
      or "--print" in args
      or not os.isatty(0)
      or not os.isatty(1)
      or os.environ.get("DEMO_NO_A2A") == "1"
      or os.environ.get("A2A_CLAUDE_WRAPPED") == "1"
  ):
    os.execv(real_claude, [real_claude] + args)

  sock_path = "/tmp/a2a-wake.sock"

  try:
    os.unlink(sock_path)
  except FileNotFoundError:
    pass

  pid, master_fd = pty.fork()
  if pid == 0:
    os.environ["A2A_CLAUDE_WRAPPED"] = "1"
    os.execv(real_claude, [real_claude] + args)

  def sync_winsize():
    try:
      packed = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\x00" * 8)
      fcntl.ioctl(master_fd, termios.TIOCSWINSZ, packed)
    except Exception:
      pass

  sync_winsize()
  signal.signal(signal.SIGWINCH, lambda *_: sync_winsize())

  last_output_time = time.time()

  def inject_prompt(text: str):
    clean = text.strip()
    if not clean:
      return
    # Wait until Claude's TUI output has settled at the idle prompt (`❯ `)
    for _ in range(40):
      if time.time() - last_output_time >= 1.0:
        break
      time.sleep(0.2)
    try:
      os.write(master_fd, clean.encode("utf-8"))
      time.sleep(0.25)
      os.write(master_fd, b"\r")
    except OSError:
      pass

  srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
  srv.bind(sock_path)
  srv.listen(5)
  srv.setblocking(False)

  old_termios = None
  try:
    old_termios = termios.tcgetattr(0)
    tty.setraw(0)
  except Exception:
    pass

  try:
    while True:
      rlist, _, _ = select.select([0, master_fd, srv], [], [], 0.5)
      if 0 in rlist:
        try:
          data = os.read(0, 4096)
          if not data:
            break
          os.write(master_fd, data)
        except OSError:
          break
      if master_fd in rlist:
        try:
          data = os.read(master_fd, 4096)
          if not data:
            break
          last_output_time = time.time()
          os.write(1, data)
        except OSError:
          break
      if srv in rlist:
        conn, _ = srv.accept()
        try:
          payload = conn.recv(4096).decode("utf-8", errors="ignore")
          if payload:
            threading.Thread(
                target=inject_prompt, args=(payload,), daemon=True
            ).start()
        finally:
          conn.close()
  finally:
    if old_termios is not None:
      try:
        termios.tcsetattr(0, termios.TCSADRAIN, old_termios)
      except Exception:
        pass
    try:
      srv.close()
    except Exception:
      pass
    try:
      os.unlink(sock_path)
    except FileNotFoundError:
      pass
    try:
      os.waitpid(pid, 0)
    except Exception:
      pass


if __name__ == "__main__":
  main()
