#!/usr/bin/env bash
# Transparent wrapper for `claude` in $DEMO_DIR/bin:
# - For `claude -p` (used by bot servers), execs the real `claude` binary directly with zero overhead.
# - For interactive caller sessions (in macOS Terminal.app), provides the `/tmp/a2a-wake.sock` PTY stdin
#   bridge so A2A push notifications can inject a prompt + Return directly into the chat input box!
set -euo pipefail
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

REAL_CLAUDE="$(python3 -c '
import os, shutil, sys
self_dir = os.path.realpath(sys.argv[1])
paths = [p for p in os.environ.get("PATH", "").split(os.pathsep) if os.path.realpath(p) != self_dir]
print(shutil.which("claude", path=os.pathsep.join(paths)) or "")
' "$SELF_DIR")"

if [[ -z "$REAL_CLAUDE" ]]; then
  echo "Error: real claude binary not found in PATH" >&2
  exit 1
fi

# Pass non-interactive (`-p` / `--print`) or non-TTY invocations straight to the real `claude` binary
for arg in "$@"; do
  if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
    exec "$REAL_CLAUDE" "$@"
  fi
done

if [[ ! -t 0 || ! -t 1 || "${DEMO_NO_A2A:-0}" == "1" ]]; then
  exec "$REAL_CLAUDE" "$@"
fi

exec python3 - "$REAL_CLAUDE" "$@" << 'PYEOF'
import fcntl
import os
import pty
import select
import signal
import socket
import sys
import termios
import threading
import time
import tty

real_claude = sys.argv[1]
claude_args = sys.argv[2:]
is_continue = "-c" in claude_args or "--continue" in claude_args
sock_path = "/tmp/a2a-wake.sock"
pending_file = "/tmp/a2a-pending-wake"

if not is_continue:
    try:
        os.unlink(pending_file)
    except FileNotFoundError:
        pass

try:
    os.unlink(sock_path)
except FileNotFoundError:
    pass

cmd = [real_claude] + claude_args

pid, master_fd = pty.fork()
if pid == 0:
    os.execv(real_claude, cmd)

def sync_winsize():
    try:
        packed = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\x00" * 8)
        fcntl.ioctl(master_fd, termios.TIOCSWINSZ, packed)
    except Exception:
        pass

sync_winsize()
signal.signal(signal.SIGWINCH, lambda *_: sync_winsize())

def inject_prompt(text: str):
    clean = text.strip()
    if not clean:
        return
    try:
        os.write(master_fd, clean.encode("utf-8"))
        time.sleep(0.2)
        os.write(master_fd, b"\r")
    except OSError:
        pass

srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
srv.bind(sock_path)
srv.listen(5)
srv.setblocking(False)

if is_continue and os.path.exists(pending_file):
    try:
        with open(pending_file, "r", encoding="utf-8") as pf:
            msg = pf.read().strip()
        os.unlink(pending_file)
        if msg:
            threading.Timer(2.2, inject_prompt, args=(msg,)).start()
    except Exception:
        pass

stdin_fd = sys.stdin.fileno()
stdout_fd = sys.stdout.fileno()
old_termios = None
try:
    old_termios = termios.tcgetattr(stdin_fd)
    tty.setraw(stdin_fd)
except Exception:
    pass

try:
    while True:
        rlist, _, _ = select.select([stdin_fd, master_fd, srv], [], [], 0.5)
        if stdin_fd in rlist:
            data = os.read(stdin_fd, 4096)
            if not data:
                break
            os.write(master_fd, data)
        if master_fd in rlist:
            try:
                data = os.read(master_fd, 4096)
                if not data:
                    break
                os.write(stdout_fd, data)
            except OSError:
                break
        if srv in rlist:
            conn, _ = srv.accept()
            try:
                payload = conn.recv(4096).decode("utf-8", errors="ignore")
                if payload:
                    threading.Thread(target=inject_prompt, args=(payload,), daemon=True).start()
            finally:
                conn.close()
finally:
    if old_termios is not None:
        try:
            termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_termios)
        except Exception:
            pass
    try:
        srv.close()
    except Exception:
        pass
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    try:
        os.waitpid(pid, 0)
    except Exception:
        pass
PYEOF
