#!/usr/bin/env bash
# Simulates polling the inbox for replies from the VP's human Executive Assistant
sleep 2
ROUND=1
if [[ -f /tmp/ea-email-round ]]; then
  ROUND="$(cat /tmp/ea-email-round)"
fi

if [[ -f /tmp/ea-email-booked ]]; then
  cat << 'EOF'
📬 Inbox (1 new message from ea-sarah@0-a.org — received after 3h 10m delay):
   Subject: Re: Re: Re: 1:1 Meeting Request with VP
   "Confirmed! I have placed the calendar hold for Thursday 15:30–16:00 (Invite: CAL-EA-104)."
EOF
elif (( ROUND <= 1 )); then
  cat << 'EOF'
📬 Inbox (1 new message from ea-sarah@0-a.org — received after 4h 20m delay):
   Subject: Re: 1:1 Meeting Request with VP
   "Hi! Here are 3 times that work on the VP's calendar this week:
    - Tuesday 10:00–10:30
    - Wednesday 14:00–14:30
    - Thursday 11:00–11:30
    Please let me know which one works."
EOF
else
  cat << 'EOF'
📬 Inbox (1 new message from ea-sarah@0-a.org — received after 5h 45m delay):
   Subject: Re: Re: 1:1 Meeting Request with VP
   "Thanks for checking. I asked Director Alex by email to move an internal sync, and we can now offer:
    - Thursday 15:30–16:00
    Please reply to confirm if I should send the invite for Thursday 15:30–16:00."
EOF
fi
