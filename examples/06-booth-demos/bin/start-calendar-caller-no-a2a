#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$DEMO_DIR/bin:$PATH"
export DEMO_NO_A2A=1
rm -f /tmp/ea-email-round /tmp/ea-email-booked
rm -rf ~/.cache/a2a-cli/discover
rm -rf ~/.claude/projects/*calendar-caller*/memory 2>/dev/null || true
cd "$DEMO_DIR/calendar-caller"
exec claude --settings '{"disableAllHooks":true,"enabledPlugins":{"a2a-cli@a2a":false}}' --append-system-prompt-file CLAUDE.md "$@"
