#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$DEMO_DIR/../.." && pwd)"
export PATH="$DEMO_DIR/bin:$PATH"

echo "🔨 Building a2a CLI (with PushNotifications enabled)..."
go -C "$REPO_ROOT" build -o "$DEMO_DIR/bin/a2a" .

cat > "$DEMO_DIR/pc-bot/mcp.json" << EOF
{
  "mcpServers": {
    "rigfoundry": {
      "command": "python3",
      "args": ["$DEMO_DIR/pc-bot/pc_store_mcp.py"]
    }
  }
}
EOF

exec "$DEMO_DIR/bin/a2a" server --host 127.0.0.1 --port 8081 \
  --card "$DEMO_DIR/pc-bot/card.json" \
  --exec "$DEMO_DIR/pc-bot/run_agent.sh"
