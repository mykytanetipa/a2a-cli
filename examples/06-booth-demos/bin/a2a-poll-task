#!/usr/bin/env bash
# Starts a local HTTP webhook listener on http://127.0.0.1:<port>/webhook.
# When the A2A server pushes `TASK_STATE_COMPLETED` to the webhook:
# 1. Fires the macOS desktop notification + sound,
# 2. Checks if `claude` is still running on CALLER_TTY (`pgrep -t <tty> claude`):
#    - If open, sends the wake prompt + Return to that terminal session via `osascript`.
#    - If closed via `/exit`, prints the notification line to CALLER_TTY so the user can run `start-pc-caller -c`.
set -eo pipefail
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
export PATH="$BIN_DIR:$PATH"

AGENT_URL="${1:-http://localhost:8081}"
TASK_ID="${2:-}"
CALLER_TTY="${3:-}"
WEBHOOK_PORT="${4:-19081}"
if [[ -z "$TASK_ID" ]]; then
  exit 0
fi

python3 - "$AGENT_URL" "$TASK_ID" "$CALLER_TTY" "$WEBHOOK_PORT" << 'PYEOF'
import os, subprocess, sys
from http.server import BaseHTTPRequestHandler, HTTPServer

agent_url = sys.argv[1]
task_id = sys.argv[2]
caller_tty = sys.argv[3]
port = int(sys.argv[4])
done = False

def wake_open_claude(tty_path: str, wake_msg: str) -> bool:
    if not tty_path:
        return False
    tty_short = tty_path.replace("/dev/", "")
    chk = subprocess.run(
        ["pgrep", "-t", tty_short, "claude"],
        capture_output=True,
        text=True,
        check=False,
    )
    if chk.returncode != 0 or not chk.stdout.strip():
        return False

    applescript = f'''
    set targetTTY to "{tty_path}"
    set wakeText to "{wake_msg}"
    if application "iTerm2" is running then
        tell application "iTerm2"
            repeat with w in windows
                repeat with t in tabs of w
                    repeat with s in sessions of t
                        if (tty of s) is targetTTY then
                            tell s to write text wakeText
                            return "woke_iterm"
                        end if
                    end repeat
                end repeat
            end repeat
        end tell
    end if
    if application "Terminal" is running then
        tell application "Terminal"
            repeat with w in windows
                repeat with t in tabs of w
                    if (tty of t) is targetTTY then
                        set selected of t to true
                        set index of w to 1
                        activate
                        delay 0.15
                        tell application "System Events"
                            keystroke wakeText
                            delay 0.15
                            key code 36
                        end tell
                        return "woke_terminal"
                    end if
                end repeat
            end repeat
        end tell
    end if
    return "no_match"
    '''
    res = subprocess.run(
        ["osascript", "-e", applescript],
        capture_output=True,
        text=True,
        check=False,
    )
    return "woke_" in (res.stdout or "")

def notify():
    subprocess.run([
        "osascript", "-e",
        f'display notification "Task {task_id} completed — $999 White+Walnut Build verified & ready!" with title "🔔 A2A Push Notification (RigFoundry)" sound name "Glass"'
    ], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.Popen(["afplay", "/System/Library/Sounds/Glass.aiff"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    wake_msg = f"Task {task_id} on {agent_url} is now completed. Run a2a task get to retrieve the build."
    woke = wake_open_claude(caller_tty, wake_msg)

    if not woke and caller_tty:
        try:
            with open(caller_tty, "w") as f:
                f.write(f"\n\033[1;32m🔔 [A2A PUSH NOTIFICATION] Webhook received TASK_STATE_COMPLETED for Task {task_id}!\033[0m\n")
        except Exception:
            pass

class WebhookHandler(BaseHTTPRequestHandler):
    def do_POST(self):
        global done
        length = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(length).decode("utf-8", errors="replace")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", "11")
        self.end_headers()
        self.wfile.write(b'{"ok":true}')
        self.wfile.flush()
        if "TASK_STATE_COMPLETED" in raw or '"completed"' in raw.lower():
            notify()
            done = True
    def log_message(self, *args):
        pass

srv = HTTPServer(("127.0.0.1", port), WebhookHandler)
srv.timeout = 180
while not done:
    srv.handle_request()
PYEOF
