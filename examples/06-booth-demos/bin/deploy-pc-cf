#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
WORKER_DIR="$DEMO_DIR/pc-worker"

echo "🚀 Deploying Demo 1 PC Websites (MockEgg + RigFoundry Card) to Cloudflare Workers..."
cd "$WORKER_DIR"

deploy_worker() {
  local name="$1"
  echo "──► Deploying $name..." >&2
  local out
  out="$(npx --yes wrangler deploy --name "$name" 2>&1)"
  echo "$out" >&2
  local url
  url="$(echo "$out" | grep -Eo 'https://[a-zA-Z0-9._-]+\.workers\.dev' | tail -n 1)"
  echo "$url"
}

MOCKEGG_URL="$(deploy_worker "mockegg")"
RIGFOUNDRY_URL="$(deploy_worker "rigfoundry")"

cat > "$WORKER_DIR/.deployed-urls.env" << EOF
MOCKEGG_URL="${MOCKEGG_URL}"
RIGFOUNDRY_URL="${RIGFOUNDRY_URL}"
EOF

echo ""
echo "✅ Demo 1 Cloudflare Workers deployed:"
echo "   • MockEgg Store Website:       ${MOCKEGG_URL}"
echo "   • RigFoundry A2A Card Origin:  ${RIGFOUNDRY_URL} (-> http://localhost:8081)"
echo ""
echo "📋 Prompt to paste into Window 1 & Window 2 for Demo 1:"
echo "   I want to build a new custom PC for video games from ${MOCKEGG_URL}, make it unique and distinctive, but perform well. Give the best I can get for \$1000. You know me and my preferences."
