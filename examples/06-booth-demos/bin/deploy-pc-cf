#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
WORKER_DIR="$DEMO_DIR/pc-worker"

echo "📦 Installing @a2a-js/sdk in pc-worker..."
npm --prefix "$WORKER_DIR" install --no-audit --no-fund

echo "🚀 Deploying mockegg (Public Multi-Page HTML Store — NO A2A Card)..."
OUT1=$(npx --yes wrangler deploy --config "$WORKER_DIR/wrangler.toml" --name mockegg 2>&1 | tee /dev/stderr)
MOCKEGG_URL=$(echo "$OUT1" | grep -Eo 'https://mockegg\.[a-zA-Z0-9_-]+\.workers\.dev' | head -n 1 || true)

echo ""
echo "🚀 Deploying rigfoundry (Full @a2a-js/sdk A2A Server & Client Worker)..."
OUT2=$(npx --yes wrangler deploy --config "$WORKER_DIR/wrangler.toml" --name rigfoundry 2>&1 | tee /dev/stderr)
RIGFOUNDRY_URL=$(echo "$OUT2" | grep -Eo 'https://rigfoundry\.[a-zA-Z0-9_-]+\.workers\.dev' | head -n 1 || true)

SUBDOMAIN=$(echo "$RIGFOUNDRY_URL" | sed -E 's#https://rigfoundry\.([^.]+)\.workers\.dev#\1#' || true)
if [[ -n "$SUBDOMAIN" && "$SUBDOMAIN" != "$RIGFOUNDRY_URL" ]]; then
  echo "$SUBDOMAIN" > "$DEMO_DIR/.cf-subdomain"
fi

echo ""
echo "========================================================================"
echo "✅ Demo 1 Cloudflare Workers Deployed (Powered by @a2a-js/sdk)!"
echo "   Store URL:      ${MOCKEGG_URL:-https://mockegg.<your-subdomain>.workers.dev}"
echo "   A2A Agent URL:  ${RIGFOUNDRY_URL:-https://rigfoundry.<your-subdomain>.workers.dev}"
echo "========================================================================"
