#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$DEMO_DIR/../.." && pwd)"
export PATH="$DEMO_DIR/bin:$PATH"

if [[ ! -x "$DEMO_DIR/bin/a2a" ]]; then
  echo "🔨 Building a2a CLI..."
  go -C "$REPO_ROOT" build -o "$DEMO_DIR/bin/a2a" .
fi

SUBDOMAIN="booth-demos"
if [[ -f "$DEMO_DIR/.cf-subdomain" ]]; then
  SUBDOMAIN="$(cat "$DEMO_DIR/.cf-subdomain" | tr -d '[:space:]')"
fi
ALEX_WORKER_URL="https://alex-schedule-bot.${SUBDOMAIN}.workers.dev"

if [[ -f "$DEMO_DIR/calendar-worker/.deployed-urls.env" ]]; then
  source "$DEMO_DIR/calendar-worker/.deployed-urls.env"
  ALEX_WORKER_URL="${ALEX_AGENT_URL:-$ALEX_WORKER_URL}"
fi

cat > "$DEMO_DIR/alex-bot/mcp.json" << EOF
{
  "mcpServers": {
    "alex_calendar": {
      "command": "python3",
      "args": ["$DEMO_DIR/alex-bot/alex_calendar_mcp.py"]
    }
  }
}
EOF

cleanup() {
  kill $(jobs -p) 2>/dev/null || true
}
trap cleanup EXIT INT TERM

lsof -ti tcp:8084 | xargs kill -9 2>/dev/null || true

TUNNEL_LOG="$(mktemp)"
npx --yes cloudflared tunnel --url http://127.0.0.1:8084 >"$TUNNEL_LOG" 2>&1 &
(
  for _ in $(seq 1 30); do
    TURL="$(grep -Eo 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" | head -n 1 || true)"
    if [[ -n "$TURL" ]]; then
      curl -sS -X POST "${ALEX_WORKER_URL}/_admin/register-upstream" \
        -H "Content-Type: application/json" \
        -d "{\"upstreamUrl\":\"${TURL}\"}" >/dev/null 2>&1 || true
      printf "\033[1;32m🌐 Connected Cloudflare Worker (%s) -> Local Alex Schedule-Bot via %s\033[0m\n" "$ALEX_WORKER_URL" "$TURL"
      break
    fi
    sleep 1
  done
) &

exec "$DEMO_DIR/bin/a2a" server --host 127.0.0.1 --port 8084 \
  --card "$DEMO_DIR/alex-bot/card.json" \
  --exec "$DEMO_DIR/alex-bot/run_agent.sh"
