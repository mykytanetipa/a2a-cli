#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PLUGIN_DIR="$(cd "$DEMO_DIR/../../agent-plugin" && pwd)"
export PATH="$DEMO_DIR/bin:$PATH"
rm -rf ~/.cache/a2a-cli/discover

if [[ "${1:-}" != "-c" && "${1:-}" != "--continue" ]]; then
  rm -rf ~/.claude/projects/*pc-caller*/memory 2>/dev/null || true
  rm -f /tmp/a2a-pending-wake 2>/dev/null || true
fi

cd "$DEMO_DIR/pc-caller"

exec python3 - "$PLUGIN_DIR" "$@" << 'PYEOF'
import fcntl
import os
import pty
import select
import signal
import socket
import struct
import sys
import termios
import threading
import time
import tty

plugin_dir = sys.argv[1]
extra_args = sys.argv[2:]
is_continue = "-c" in extra_args or "--continue" in extra_args
sock_path = "/tmp/a2a-wake.sock"
pending_file = "/tmp/a2a-pending-wake"

try:
    os.unlink(sock_path)
except FileNotFoundError:
    pass

cmd = [
    "claude",
    "--settings",
    '{"enabledPlugins":{"a2a-cli@a2a":false}}',
    "--plugin-dir",
    plugin_dir,
    "--append-system-prompt-file",
    "CLAUDE.md",
] + extra_args

pid, master_fd = pty.fork()
if pid == 0:
    os.execvp(cmd[0], cmd)

def sync_winsize():
    try:
        packed = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, b"\x00" * 8)
        fcntl.ioctl(master_fd, termios.TIOCSWINSZ, packed)
    except Exception:
        pass

sync_winsize()
signal.signal(signal.SIGWINCH, lambda *_: sync_winsize())

def inject_prompt(text: str):
    clean = text.strip()
    if not clean:
        return
    try:
        os.write(master_fd, clean.encode("utf-8"))
        time.sleep(0.18)
        os.write(master_fd, b"\r")
    except OSError:
        pass

srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
srv.bind(sock_path)
srv.listen(5)
srv.setblocking(False)

if is_continue and os.path.exists(pending_file):
    try:
        with open(pending_file, "r", encoding="utf-8") as pf:
            msg = pf.read().strip()
        os.unlink(pending_file)
        if msg:
            threading.Timer(2.2, inject_prompt, args=(msg,)).start()
    except Exception:
        pass

stdin_fd = sys.stdin.fileno()
stdout_fd = sys.stdout.fileno()
old_termios = None
try:
    old_termios = termios.tcgetattr(stdin_fd)
    tty.setraw(stdin_fd)
except Exception:
    pass

try:
    while True:
        rlist, _, _ = select.select([stdin_fd, master_fd, srv], [], [], 0.5)
        if stdin_fd in rlist:
            data = os.read(stdin_fd, 4096)
            if not data:
                break
            os.write(master_fd, data)
        if master_fd in rlist:
            try:
                data = os.read(master_fd, 4096)
                if not data:
                    break
                os.write(stdout_fd, data)
            except OSError:
                break
        if srv in rlist:
            conn, _ = srv.accept()
            try:
                payload = conn.recv(4096).decode("utf-8", errors="ignore")
                if payload:
                    threading.Thread(target=inject_prompt, args=(payload,), daemon=True).start()
            finally:
                conn.close()
finally:
    if old_termios is not None:
        try:
            termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_termios)
        except Exception:
            pass
    try:
        srv.close()
    except Exception:
        pass
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    try:
        os.waitpid(pid, 0)
    except Exception:
        pass
PYEOF
