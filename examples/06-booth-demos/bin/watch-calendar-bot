#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="$DEMO_DIR/calendar-worker/.deployed-urls.env"

if [[ -f "$ENV_FILE" ]]; then
  source "$ENV_FILE"
else
  echo "⚠️  No .deployed-urls.env found. Run ./examples/06-booth-demos/bin/deploy-calendar-cf first."
  exit 1
fi

# Reset remote Cloudflare Worker state and local email fallback state before recording
rm -f /tmp/ea-email-round /tmp/ea-email-booked
curl -s -X POST "${VP_AGENT_URL}/reset" >/dev/null || true

clear
printf "\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n"
printf "\033[1;35m📡 Cloudflare Workers Live A2A Stream (Window 3)\033[0m\n"
printf "   • VP Schedule-Bot:   \033[4;36m%s\033[0m\n" "${VP_AGENT_URL}"
printf "   • Alex Schedule-Bot: \033[4;36m%s\033[0m\n" "${ALEX_AGENT_URL}"
printf "\033[1;35m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n"

CURSOR=0
while true; do
  RESP="$(curl -s "${VP_AGENT_URL}/logs?since=${CURSOR}" || echo '{}')"
  NEXT="$(printf "%s" "$RESP" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
    for e in d.get("entries", []):
        print(e.get("text", ""), file=sys.stderr)
    print(d.get("nextCursor", 0))
except Exception:
    print(0)
' 2>&1 >/tmp/cf_cursor.$$)"
  if [[ -n "$NEXT" ]]; then
    printf "%b\n" "$NEXT"
  fi
  if [[ -f "/tmp/cf_cursor.$$" ]]; then
    NEW_C="$(cat "/tmp/cf_cursor.$$" | tr -d '[:space:]')"
    rm -f "/tmp/cf_cursor.$$"
    if [[ "$NEW_C" =~ ^[0-9]+$ ]] && (( NEW_C > CURSOR )); then
      CURSOR="$NEW_C"
    fi
  fi
  sleep 0.5
done
