#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$DEMO_DIR/../.." && pwd)"
export PATH="$DEMO_DIR/bin:$PATH"

echo "🔨 Building a2a CLI..."
go -C "$REPO_ROOT" build -o "$DEMO_DIR/bin/a2a" .

SUBDOMAIN="booth-demos"
if [[ -f "$DEMO_DIR/.cf-subdomain" ]]; then
  SUBDOMAIN="$(cat "$DEMO_DIR/.cf-subdomain" | tr -d '[:space:]')"
fi
VP_WORKER_URL="https://vp-schedule-bot.${SUBDOMAIN}.workers.dev"
ALEX_WORKER_URL="https://alex-schedule-bot.${SUBDOMAIN}.workers.dev"
SARAH_WORKER_URL="https://vp-sarah.${SUBDOMAIN}.workers.dev"

if [[ -f "$DEMO_DIR/calendar-worker/.deployed-urls.env" ]]; then
  source "$DEMO_DIR/calendar-worker/.deployed-urls.env"
  VP_WORKER_URL="${VP_AGENT_URL:-$VP_WORKER_URL}"
  ALEX_WORKER_URL="${ALEX_AGENT_URL:-$ALEX_WORKER_URL}"
else
  cat > "$DEMO_DIR/calendar-worker/.deployed-urls.env" << EOF
VP_AGENT_URL="${VP_WORKER_URL}"
ALEX_AGENT_URL="${ALEX_WORKER_URL}"
SARAH_PROFILE_URL="${SARAH_WORKER_URL}"
EOF
fi

export ALEX_AGENT_URL="$ALEX_WORKER_URL"

cat > "$DEMO_DIR/calendar-bot/mcp.json" << EOF
{
  "mcpServers": {
    "vp_calendar": {
      "command": "python3",
      "args": ["$DEMO_DIR/calendar-bot/vp_calendar_mcp.py"],
      "env": {
        "ALEX_AGENT_URL": "$ALEX_WORKER_URL"
      }
    }
  }
}
EOF

cleanup() {
  kill $(jobs -p) 2>/dev/null || true
}
trap cleanup EXIT INT TERM

lsof -ti tcp:8082 | xargs kill -9 2>/dev/null || true

TUNNEL_LOG="$(mktemp)"
npx --yes cloudflared tunnel --url http://127.0.0.1:8082 >"$TUNNEL_LOG" 2>&1 &
(
  for _ in $(seq 1 30); do
    TURL="$(grep -Eo 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' "$TUNNEL_LOG" | head -n 1 || true)"
    if [[ -n "$TURL" ]]; then
      curl -sS -X POST "${VP_WORKER_URL}/_admin/register-upstream" \
        -H "Content-Type: application/json" \
        -d "{\"upstreamUrl\":\"${TURL}\"}" >/dev/null 2>&1 || true
      printf "\033[1;32m🌐 Connected Cloudflare Worker (%s) -> Local VP Schedule-Bot via %s\033[0m\n" "$VP_WORKER_URL" "$TURL"
      break
    fi
    sleep 1
  done
) &

exec "$DEMO_DIR/bin/a2a" server --host 127.0.0.1 --port 8082 \
  --card "$DEMO_DIR/calendar-bot/card.json" \
  --exec "$DEMO_DIR/calendar-bot/run_agent.sh"
