#!/usr/bin/env bash
# PostToolUse hook for Bash:
# - When Claude runs `a2a send --async`, ensures the local HTTP webhook listener (`a2a-poll-task`)
#   is running on http://127.0.0.1:19081/webhook so that after Claude registers the push config
#   (`a2a task push-config create ... --url http://127.0.0.1:19081/webhook`), the listener receives
#   the server's webhook POST and fires the macOS desktop notification!
set -eo pipefail
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
export PATH="$BIN_DIR:$PATH"
INPUT="$(cat)"

PARSED="$(printf "%s" "$INPUT" | python3 -c '
import json, re, sys
try:
    d = json.load(sys.stdin)
    cmd = str(d.get("tool_input", {}).get("command", ""))
    if "a2a" not in cmd or "send" not in cmd or "--async" not in cmd:
        sys.exit(0)
    resp = json.dumps(d.get("tool_response", ""))
    m_task = re.search(r"Task:\s+([0-9a-fA-F-]{8,})", resp)
    if not m_task:
        m_task = re.search(r"\\\"id\\\"\s*:\s*\\\"([0-9a-fA-F-]{8,})\\\"", resp)
    if not m_task:
        m_task = re.search(r"\"id\"\s*:\s*\"([0-9a-fA-F-]{8,})\"", resp)
    m_agent = re.search(r"(?:-a|--agent-card)\s+([^\s\"'"'"']+)", cmd)
    if m_task:
        agent = m_agent.group(1) if m_agent else "http://localhost:8081"
        print(f"{m_task.group(1)}|{agent}")
except Exception:
    pass
')"

if [[ -z "$PARSED" ]]; then
  exit 0
fi

TASK_ID="${PARSED%%|*}"
AGENT_URL="${PARSED#*|}"
CALLER_TTY="$(python3 -c '
import os, subprocess
pid = os.getppid()
for _ in range(6):
    if pid <= 1:
        break
    tty = subprocess.run(["ps", "-o", "tty=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    if tty and tty != "??":
        print(f"/dev/{tty}")
        break
    ppid = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
    pid = int(ppid) if ppid.isdigit() else 0
' 2>/dev/null || true)"

# Kill any stale listener on 19081 and start a fresh detached listener for this task
lsof -ti tcp:19081 | xargs kill -9 2>/dev/null || true
nohup "$BIN_DIR/a2a-poll-task" "$AGENT_URL" "$TASK_ID" "$CALLER_TTY" 19081 >/dev/null 2>&1 &
