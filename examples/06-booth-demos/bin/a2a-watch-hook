#!/usr/bin/env bash
# PostToolUse hook for Bash: detects when `a2a send --async` returns a submitted/working Task ID,
# starts the local HTTP webhook listener (`a2a-poll-task`), registers the webhook with the A2A server
# via `a2a task push-config create`, and instructs Claude Code to stop without polling.
set -eo pipefail
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
export PATH="$BIN_DIR:$PATH"
INPUT="$(cat)"

PARSED="$(printf "%s" "$INPUT" | python3 -c '
import json, re, sys
try:
    d = json.load(sys.stdin)
    cmd = str(d.get("tool_input", {}).get("command", ""))
    if "a2a" not in cmd or "send" not in cmd or "--async" not in cmd:
        sys.exit(0)
    resp = json.dumps(d.get("tool_response", ""))
    m_task = re.search(r"Task:\s+([0-9a-fA-F-]{8,})", resp)
    if not m_task:
        m_task = re.search(r"\\\"id\\\"\s*:\s*\\\"([0-9a-fA-F-]{8,})\\\"", resp)
    if not m_task:
        m_task = re.search(r"\"id\"\s*:\s*\"([0-9a-fA-F-]{8,})\"", resp)
    m_agent = re.search(r"(?:-a|--agent-card)\s+([^\s\"'"'"']+)", cmd)
    if m_task:
        agent = m_agent.group(1) if m_agent else "http://localhost:8081"
        print(f"{m_task.group(1)}|{agent}")
except Exception:
    pass
')"

if [[ -z "$PARSED" ]]; then
  exit 0
fi

TASK_ID="${PARSED%%|*}"
AGENT_URL="${PARSED#*|}"
CALLER_TTY="$(ps -o tty= -p $PPID 2>/dev/null | tr -d ' ' || true)"
if [[ -n "$CALLER_TTY" && "$CALLER_TTY" != "??" ]]; then
  CALLER_TTY="/dev/${CALLER_TTY}"
else
  CALLER_TTY=""
fi

WEBHOOK_PORT="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
WEBHOOK_URL="http://127.0.0.1:${WEBHOOK_PORT}/webhook"

# 1. Start the detached HTTP webhook receiver (survives closing Claude Code)
nohup "$BIN_DIR/a2a-poll-task" "$AGENT_URL" "$TASK_ID" "$CALLER_TTY" "$WEBHOOK_PORT" >/dev/null 2>&1 &
BG_PID=$!
sleep 0.2

# 2. Register the push notification webhook with the A2A server via `a2a task push-config create`
PUSH_OUT="$(a2a task push-config create -a "$AGENT_URL" "$TASK_ID" --url "$WEBHOOK_URL" 2>&1 || true)"
CONFIG_ID="$(echo "$PUSH_OUT" | awk '/^Config:/ {print $2}')"

python3 -c '
import json, sys
task_id, agent_url, pid, webhook_url, config_id = sys.argv[1:6]
cfg_note = f" (Config ID: {config_id})" if config_id else ""
sys_msg = f"🔔 [A2A Push Hook] Registered push webhook (`a2a task push-config create` -> {webhook_url}){cfg_note} for Task {task_id}"
ctx_msg = (
    f"SYSTEM HOOK NOTICE: Registered A2A push notification webhook (`a2a task push-config create -a {agent_url} {task_id} --url {webhook_url}`){cfg_note} "
    f"with detached listener PID {pid}. The A2A server will push a notification to the user when Task {task_id} finishes. "
    f"CRITICAL: Do NOT call `a2a task get` or poll in this turn. Simply report the Task ID ({task_id}) "
    f"to the user and end your turn immediately so the user can close the session and check status later."
)
print(json.dumps({
    "systemMessage": sys_msg,
    "hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": ctx_msg
    }
}))
' "$TASK_ID" "$AGENT_URL" "$BG_PID" "$WEBHOOK_URL" "$CONFIG_ID"
