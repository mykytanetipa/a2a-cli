#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
WORKER_DIR="$DEMO_DIR/calendar-worker"

echo "📦 Installing @a2a-js/sdk in calendar-worker..."
npm --prefix "$WORKER_DIR" install --no-audit --no-fund

WHOAMI_OUT="$(npx --yes wrangler whoami 2>&1 || true)"
if echo "$WHOAMI_OUT" | grep -Eqi "not authenticated|login|error"; then
  echo "🔐 Logging in to Cloudflare Wrangler (opening browser)..."
  npx --yes wrangler login
fi

echo "🚀 Deploying vp-schedule-bot (VP Yaroslav's @a2a-js/sdk A2A Agent)..."
npx --yes wrangler deploy --config "$WORKER_DIR/wrangler.toml" --name vp-schedule-bot

echo ""
echo "🚀 Deploying alex-schedule-bot (Director Alex's @a2a-js/sdk A2A Agent)..."
npx --yes wrangler deploy --config "$WORKER_DIR/wrangler.toml" --name alex-schedule-bot

SUBDOMAIN="$(cat "$DEMO_DIR/.cf-subdomain" 2>/dev/null || echo "booth-demos")"
VP_URL="https://vp-schedule-bot.${SUBDOMAIN}.workers.dev"
ALEX_URL="https://alex-schedule-bot.${SUBDOMAIN}.workers.dev"

cat > "$WORKER_DIR/.deployed-urls.env" << EOF
VP_AGENT_URL="${VP_URL}"
ALEX_AGENT_URL="${ALEX_URL}"
EOF

echo ""
echo "========================================================================"
echo "✅ Demo 2 Cloudflare Workers Deployed (Powered by @a2a-js/sdk)!"
echo "   VP Yaroslav Agent (With A2A):  ${VP_URL}"
echo "   Director Alex Agent (A2A Hop): ${ALEX_URL}"
echo "========================================================================"
