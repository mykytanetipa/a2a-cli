#!/usr/bin/env bash
set -euo pipefail
DEMO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
rm -rf ~/.claude/projects/*pc-caller*/memory 2>/dev/null || true

WORKDIR="/tmp/pc-caller"
rm -rf "$WORKDIR"
mkdir -p "$WORKDIR"
cp "$DEMO_DIR/pc-caller/CLAUDE.md" "$WORKDIR/CLAUDE.md"
cd "$WORKDIR"

exec claude \
  --disallowedTools "Skill" \
  --settings '{"disableAllHooks":true,"enabledPlugins":{"a2a-cli@a2a":false}}' \
  --append-system-prompt-file CLAUDE.md "$@"
