{
  "alwaysThinkingEnabled": true,
  "permissions": {
    "deny": [
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Gmail__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "a2a discover --allow-private --no-cache"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch|Fetch|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "a2a discover --allow-private --no-cache"
          }
        ]
      }
    ]
  }
}
