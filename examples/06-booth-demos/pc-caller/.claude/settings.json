{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "a2a discover --allow-private"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch|Fetch|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "a2a-discover-hook"
          },
          {
            "type": "command",
            "command": "a2a-watch-hook"
          }
        ]
      }
    ]
  }
}
